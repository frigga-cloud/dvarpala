# Go
bin/
vendor/

# Compiled binaries at the repo root (output of `go build`).
# The leading slash matters: without it, "dvarpala-cli" would also match the
# cmd/dvarpala-cli/ SOURCE directory and hide the code from git.
/dvarpala-server
/dvarpala-cli
/dvarpala-worker
/openvpn-auth
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.html

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment files
.env
.env.local
.env.production

# Logs
*.log
logs/

# Database
*.db
*.sqlite

# OS
.DS_Store
Thumbs.db

# Certificates and keys
*.crt
*.key
*.pem
*.p12

# Temporary files
tmp/
temp/

# Dvarpala deployment files
dvarpala-deployment/
scripts/installation/dvarpala-deployment/

# Certificate authority material - never commit private keys
/certs/
